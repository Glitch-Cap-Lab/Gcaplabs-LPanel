import { useState } from "react";
import ChatPanel from "../components/agents/hermes/ChatPanel";
export default function ChatRecoveryPreview() {
  const [owner, setOwner] = useState("operator-a");
  const [agent, setAgent] = useState("agent-a");
  return <main className="mx-auto max-w-6xl p-6"><button onClick={() => setOwner("operator-b")}>Switch operator fixture</button><button onClick={() => setAgent("agent-b")}>Switch target fixture</button><ChatPanel agentId={agent} runtimeInfo={{ health: { ok: true }, defaultModel: "workspace-model", chatScope: { ownerId: owner, agentId: agent, profile: null } }} loadingRuntime={false} runtimeError="" onRefreshRuntime={() => {}} /></main>;
}
